<%- include('partials/head', { title: mode === 'signup' ? 'Create account' : 'Log in' }) %>
<div class="auth-shell"><div class="auth-story"><a class="brand auth-brand" href="/"><span class="brand-mark">S</span><span>stockflow<span class="brand-dot">.</span></span></a><div class="auth-story-content"><div class="eyebrow light-eyebrow"><span class="eyebrow-line"></span> MAKE ROOM TO GROW</div><h1>Stock clarity<br>starts <em>here.</em></h1><p>One calm place to keep your inventory in focus and your next move within reach.</p><div class="auth-art"><div class="auth-orbit orbit-a"></div><div class="auth-orbit orbit-b"></div><div class="auth-shelf"><span>▧</span><span>▧</span><span>▧</span></div><div class="auth-shelf shelf-two"><span>▧</span><span>▧</span><span>▧</span><span>▧</span></div><span class="auth-spark spark-a">✳</span><span class="auth-spark spark-b">✦</span><div class="floating-note"><span class="note-dot"></span> Your inventory, in focus</div></div></div><div class="auth-bottom"><span>© <%= new Date().getFullYear() %> StockFlow</span><span>Thoughtful tools for small teams.</span></div></div>
<main class="auth-main"><div class="auth-card"><span class="auth-mobile-mark">S</span><div class="eyebrow"><span class="eyebrow-line"></span> <%= mode === 'signup' ? 'A GOOD PLACE TO BEGIN' : 'WELCOME BACK' %></div><h2><%= mode === 'signup' ? 'Create your account' : 'Good to see you' %><span class="heading-period">.</span></h2><p class="auth-subtitle"><%= mode === 'signup' ? 'Start with a clean slate. Your inventory awaits.' : 'Pick up where you left your inventory.' %></p>
  <% if (error) { %><div class="flash flash-error"><span>!</span><%= error %></div><% } %>
  <form method="post" action="<%= mode === 'signup' ? '/signup' : '/login' %>" class="auth-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (mode === 'signup') { %><label class="field">Organization name<input name="organization" required maxlength="80" autocomplete="organization" placeholder="e.g. My Test Store"></label><% } %>
  <label class="field">Email address<input type="email" name="email" required maxlength="254" autocomplete="email" placeholder="you@yourstore.com" value="<%= typeof email !== 'undefined' ? email : '' %>"></label>
  <label class="field">Password<input type="password" name="password" required minlength="<%= mode === 'signup' ? 8 : 1 %>" maxlength="72" autocomplete="<%= mode === 'signup' ? 'new-password' : 'current-password' %>" placeholder="<%= mode === 'signup' ? 'At least 8 characters' : 'Enter your password' %>"></label>
  <% if (mode === 'signup') { %><label class="field">Confirm password<input type="password" name="confirm_password" required minlength="8" maxlength="72" autocomplete="new-password" placeholder="Type it once more"></label><% } %>
  <% if (mode === 'login') { %><div class="auth-hint">Your workspace and products are private to your account.</div><% } %>
  <button class="button button-primary auth-submit" type="submit"><%= mode === 'signup' ? 'Create account' : 'Log in to StockFlow' %><span>→</span></button></form>
  <div class="auth-switch"><%= mode === 'signup' ? 'Already have an account?' : 'New to StockFlow?' %> <a href="/<%= mode === 'signup' ? 'login' : 'signup' %>"><%= mode === 'signup' ? 'Log in' : 'Create an account' %> <span>↗</span></a></div>
  <div class="auth-note"><span>✳</span> A simple inventory space, made for your next chapter.</div>
</div><div class="auth-mobile-footer">© <%= new Date().getFullYear() %> StockFlow</div></main></div></body></html>
