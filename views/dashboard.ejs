<%- include('partials/head', { title: 'Overview' }) %>
<div class="app-shell"><%- include('partials/nav', { active }) %><main class="main-area"><%- include('partials/topbar', { section: 'Overview' }) %><div class="page-wrap">
  <%- include('partials/flash') %>
  <div class="welcome-row"><div><div class="eyebrow"><span class="eyebrow-line"></span> YOUR INVENTORY, IN FOCUS</div><h1>Good to have you, <%= organization.name %><span class="heading-period">.</span></h1><p class="page-subtitle">Here’s the pulse of your inventory today.</p></div><a class="button button-primary" href="/products/new"><span class="button-plus">＋</span> Add product</a></div>
  <section class="metric-grid">
    <article class="metric-card"><div class="metric-top"><span class="metric-label">Total products</span><span class="metric-icon icon-lilac">▦</span></div><div class="metric-value"><%= totals.product_count.toLocaleString() %></div><div class="metric-foot"><span class="metric-caption">In your catalog</span><span class="metric-spark spark-lilac">↗</span></div></article>
    <article class="metric-card"><div class="metric-top"><span class="metric-label">Units in stock</span><span class="metric-icon icon-mint">▤</span></div><div class="metric-value"><%= totals.unit_count.toLocaleString() %></div><div class="metric-foot"><span class="metric-caption">Across all products</span><span class="metric-spark spark-mint">↗</span></div></article>
    <article class="metric-card"><div class="metric-top"><span class="metric-label">Need attention</span><span class="metric-icon icon-peach">⌁</span></div><div class="metric-value"><%= lowStock.length.toLocaleString() %><span class="metric-unit"> items</span></div><div class="metric-foot"><span class="metric-caption"><%= lowStock.length ? 'At or below their threshold' : 'You’re in a good place' %></span><span class="metric-spark spark-peach"><%= lowStock.length ? '!' : '✓' %></span></div></article>
  </section>
  <section class="content-grid">
    <article class="panel inventory-panel"><div class="panel-heading"><div><div class="eyebrow">INVENTORY</div><h2>Low stock watch</h2><p class="panel-subtitle">Products that could use a restock.</p></div><a class="text-link" href="/products">All products <span>↗</span></a></div>
      <% if (lowStock.length) { %><div class="table-scroll"><table><thead><tr><th>PRODUCT</th><th>SKU</th><th>IN STOCK</th><th>THRESHOLD</th><th></th></tr></thead><tbody>
      <% lowStock.slice(0, 6).forEach(product => { %><tr><td><div class="product-cell"><span class="product-thumb"><%= product.name.charAt(0).toUpperCase() %></span><strong><%= product.name %></strong></div></td><td><span class="sku"><%= product.sku %></span></td><td><span class="stock-pill stock-low"><i></i><%= product.quantity %> units</span></td><td class="muted-cell"><%= product.effective_threshold %> units</td><td><a class="row-action" href="/products/<%= product.id %>/edit" aria-label="Edit <%= product.name %>">↗</a></td></tr><% }) %>
      </tbody></table></div><% } else { %><div class="empty-state"><span class="empty-check">✓</span><strong>All looking good</strong><p>Nothing is below its low stock threshold.</p><a href="/products">Browse inventory <span>↗</span></a></div><% } %>
      <% if (lowStock.length > 6) { %><div class="table-tail">Showing 6 of <%= lowStock.length %> low stock items</div><% } %>
    </article>
    <aside class="panel snapshot-panel"><div class="eyebrow">AT A GLANCE</div><h2>Your snapshot</h2><p class="panel-subtitle">A quick read on your catalog.</p><div class="snapshot-art"><div class="art-ring ring-one"></div><div class="art-ring ring-two"></div><span class="art-box box-a">▧</span><span class="art-box box-b">▧</span><span class="art-box box-c">▧</span><span class="art-star">✳</span></div><div class="snapshot-stat"><span>Catalog coverage</span><strong><%= totals.product_count ? 'Ready to grow' : 'Just getting started' %></strong></div><div class="snapshot-stat"><span>Default alert at</span><strong><%= organization.default_threshold %> units</strong></div><a class="snapshot-link" href="/settings">Adjust your settings <span>→</span></a></aside>
  </section>
  <%- include('partials/foot') %>
</div></main></div></body></html>
