<%- include('partials/head', { title: product ? 'Edit product' : 'Add product' }) %>
<div class="app-shell"><%- include('partials/nav', { active }) %><main class="main-area"><%- include('partials/topbar', { section: 'Products' }) %><div class="page-wrap form-page">
  <a class="back-link" href="/products">← <span>Back to products</span></a>
  <div class="form-heading"><div class="eyebrow"><span class="eyebrow-line"></span> PRODUCT DETAILS</div><h1><%= product ? 'Edit product' : 'Add a product' %><span class="heading-period">.</span></h1><p class="page-subtitle"><%= product ? 'Keep the details and stock level up to date.' : 'Give your inventory a new addition.' %></p></div>
  <% if (error) { %><div class="flash flash-error"><span>!</span><%= error %></div><% } %>
  <form class="panel product-form" method="post" action="<%= product ? `/products/${product.id}` : '/products' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-section"><div class="form-section-title"><span class="section-number">01</span><div><strong>Product information</strong><small>The basics to identify this item.</small></div></div>
      <div class="form-fields"><label class="field full-field">Product name <span class="required-mark">*</span><input name="name" required maxlength="120" placeholder="e.g. Ceramic pour-over set" value="<%= product?.name || '' %>"></label>
      <label class="field">SKU <span class="required-mark">*</span><input name="sku" required maxlength="64" placeholder="e.g. CF-042" value="<%= product?.sku || '' %>"><small>A unique identifier in your store.</small></label>
      <label class="field">Description <span class="optional-mark">OPTIONAL</span><textarea name="description" maxlength="1000" rows="3" placeholder="A short note about this product"><%= product?.description || '' %></textarea></label></div>
    </div>
    <div class="form-section"><div class="form-section-title"><span class="section-number">02</span><div><strong>Stock & pricing</strong><small>Set the quantity and optional pricing.</small></div></div>
      <div class="form-fields three-fields"><label class="field">Quantity on hand <span class="required-mark">*</span><input type="number" name="quantity" min="0" max="1000000000" step="1" required value="<%= product?.quantity ?? 0 %>"><small>Units currently in stock.</small></label>
      <label class="field">Cost price <span class="optional-mark">OPTIONAL</span><div class="money-input"><span>$</span><input type="number" name="cost_price" min="0" step="0.01" placeholder="0.00" value="<%= product?.cost_price ?? '' %>"></div></label>
      <label class="field">Selling price <span class="optional-mark">OPTIONAL</span><div class="money-input"><span>$</span><input type="number" name="selling_price" min="0" step="0.01" placeholder="0.00" value="<%= product?.selling_price ?? '' %>"></div></label>
      <label class="field">Low stock threshold <span class="optional-mark">OPTIONAL</span><input type="number" name="low_stock_threshold" min="0" max="1000000" step="1" placeholder="Use store default" value="<%= product?.low_stock_threshold ?? '' %>"><small>Leave blank to use the store default.</small></label></div>
    </div>
    <div class="form-actions"><a class="button button-quiet" href="/products">Cancel</a><button class="button button-primary" type="submit"><%= product ? 'Save changes' : 'Add product' %><span>→</span></button></div>
  </form>
  <%- include('partials/foot') %>
</div></main></div></body></html>
