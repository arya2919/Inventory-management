<%- include('partials/head', { title: 'Products' }) %>
<div class="app-shell"><%- include('partials/nav', { active }) %><main class="main-area"><%- include('partials/topbar', { section: 'Products' }) %><div class="page-wrap">
  <%- include('partials/flash') %>
  <div class="welcome-row compact-welcome"><div><div class="eyebrow"><span class="eyebrow-line"></span> YOUR CATALOG</div><h1>Products<span class="heading-period">.</span></h1><p class="page-subtitle">A tidy home for everything you keep in stock.</p></div><a class="button button-primary" href="/products/new"><span class="button-plus">＋</span> Add product</a></div>
  <section class="panel products-panel"><div class="products-toolbar"><div><h2>All products <span class="count-badge"><%= products.length %></span></h2><p class="panel-subtitle">Search, edit, and keep your quantities current.</p></div><form class="search-form" method="get" action="/products"><span class="search-icon">⌕</span><input name="q" value="<%= query %>" placeholder="Search name or SKU" aria-label="Search products"><% if (query) { %><a class="clear-search" href="/products" aria-label="Clear search">×</a><% } %></form></div>
  <% if (products.length) { %><div class="table-scroll"><table class="products-table"><thead><tr><th>PRODUCT</th><th>SKU</th><th>QUANTITY</th><th>STATUS</th><th>SELLING PRICE</th><th></th></tr></thead><tbody>
  <% products.forEach(product => { const effective = product.low_stock_threshold == null ? threshold : product.low_stock_threshold; const isLow = product.quantity <= effective; %><tr><td><div class="product-cell"><span class="product-thumb"><%= product.name.charAt(0).toUpperCase() %></span><div><strong><%= product.name %></strong><% if (product.description) { %><small class="description-cell"><%= product.description %></small><% } %></div></div></td><td><span class="sku"><%= product.sku %></span></td><td><strong class="quantity-cell"><%= product.quantity.toLocaleString() %></strong><span class="muted-cell"> units</span></td><td><span class="stock-pill <%= isLow ? 'stock-low' : 'stock-good' %>"><i></i><%= isLow ? 'Low stock' : 'In stock' %></span></td><td class="price-cell"><%= product.selling_price == null ? '—' : '₹' + Number(product.selling_price).toFixed(2) %></td><td><div class="row-actions"><a class="row-action" href="/products/<%= product.id %>/edit" aria-label="Edit <%= product.name %>">↗</a><form method="post" action="/products/<%= product.id %>/delete" onsubmit="return confirm('Delete this product? This cannot be undone.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="row-action delete-action" aria-label="Delete <%= product.name %>" title="Delete product">×</button></form></div></td></tr><% }) %>
  </tbody></table></div><div class="table-tail">Showing <%= products.length %> product<%= products.length === 1 ? '' : 's' %><%= query ? ` matching “${query}”` : '' %></div>
  <% } else { %><div class="empty-state products-empty"><span class="empty-check">▦</span><strong><%= query ? 'No matching products' : 'Your catalog starts here' %></strong><p><%= query ? 'Try another name or SKU.' : 'Add a product and see your inventory take shape.' %></p><% if (query) { %><a href="/products">Clear search <span>↗</span></a><% } else { %><a class="button button-primary" href="/products/new">＋ Add your first product</a><% } %></div><% } %></section>
  <%- include('partials/foot') %>
</div></main></div></body></html>
